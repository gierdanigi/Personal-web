# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# publishable key (sb_publishable_...) — 예전 프로젝트라면 NEXT_PUBLIC_SUPABASE_ANON_KEY 에 anon key를 넣어도 됨
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# 관리자 이메일 (Supabase Auth에 만든 계정, supabase/04_seed.sql 의 admins 와 같아야 함)
ADMIN_EMAIL=you@example.com

# 배포 주소 (OG 이미지 · sitemap · canonical). Vercel에서는 생략하면 프로덕션 도메인을 자동 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000
